{
  "expo": {
    "name": "订单台账",
    "slug": "order-management",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/logo-rounded.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.archie.ordermanagement",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄采购单、送货凭证和买入凭证。",
        "NSPhotoLibraryUsageDescription": "用于选择采购单、送货凭证和买入凭证。"
      }
    },
    "android": {
      "package": "com.archie.ordermanagement",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-rounded.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA"
      ],
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择采购单、送货凭证和买入凭证。",
          "cameraPermission": "用于拍摄采购单、送货凭证和买入凭证。"
        }
      ],
      "expo-document-picker",
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-logo-rounded.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#ffffff",
            "image": "./assets/splash-logo-rounded.png"
          }
        }
      ]
    ]
  }
}
